{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Himnario Adventista",
  "mainBinaryName": "himnario-adventista",
  "version": "1.0.0",
  "identifier": "org.himnario.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; font-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    },
    "windows": [
      {
        "label": "operator",
        "title": "Himnario Adventista",
        "url": "index.html?view=operator",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "visible": false,
        "backgroundColor": "#0d141b"
      },
      {
        "label": "projection",
        "title": "Himnario · Proyección",
        "url": "index.html?view=projection",
        "width": 960,
        "height": 540,
        "minWidth": 320,
        "minHeight": 180,
        "visible": false,
        "decorations": false,
        "resizable": true,
        "skipTaskbar": false,
        "backgroundColor": "#000000"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "rpm",
      "msi",
      "nsis",
      "app",
      "dmg"
    ],
    "category": "Music",
    "shortDescription": "Himnario Adventista: audio y letras sincronizadas para proyección.",
    "longDescription": "Reproduce los himnos con audio cantado o instrumental y proyecta la letra sincronizada en una segunda pantalla. Funciona sin conexión a Internet.",
    "copyright": "",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libasound2 | libasound2t64"
        ]
      },
      "rpm": {
        "depends": [
          "alsa-lib"
        ]
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
